{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/supervisor.mjs",
    "start:web": "REVIEW_PROCESS_ROLE=web REVIEW_JOB_PROCESSING_ENABLED=false node --enable-source-maps ./dist/index.mjs",
    "start:worker": "REVIEW_PROCESS_ROLE=worker REVIEW_JOB_PROCESSING_ENABLED=true node --enable-source-maps ./dist/worker.mjs",
    "start:with-db-push": "pnpm --filter @workspace/db push-force && node --enable-source-maps ./dist/supervisor.mjs",
    "pretypecheck": "pnpm -w run typecheck:libs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "openai": "^4",
    "openid-client": "^6.5.0",
    "pdf-parse": "^1.1.1",
    "pg": "8.20.0",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
